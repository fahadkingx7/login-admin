{
  "manifest_version": 3,
  "name": "LogIn Admin",
  "version": "6.1.33",
  "description": "LogIn, share simply",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "storage",
    "browsingData",
    "management",
    "declarativeNetRequest",
    "proxy",
    "scripting",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestAuthProvider",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LogIn",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon32.png",
      "32": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
